# Copy to .env.local and adjust.
#
# Vite only exposes variables prefixed with VITE_, and anything prefixed VITE_
# IS PUBLIC — it gets inlined into the JavaScript bundle. Never put an API key
# or any other secret in this file.

# Where contact enquiries are delivered
VITE_CONTACT_TO_EMAIL=info@divlynx.com

# Calendly booking link
VITE_CALENDLY_URL=https://calendly.com/divlynx-inc/book-a-call-30-mins

# Webmail provider used by the fallback compose link (gmail | outlook | yahoo)
VITE_DEFAULT_WEBMAIL=gmail

# ---------------------------------------------------------------------------
# The contact form posts to /api/contact, a Firebase Function that sends via
# Resend. Its API key is a SERVER secret and does not belong in this file.
# Set it once with:
#
#   firebase functions:secrets:set RESEND_API_KEY
#
# The sending address (noreply@divlynx.com) and recipient are in
# functions/index.js.
# ---------------------------------------------------------------------------
