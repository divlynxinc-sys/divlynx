# Copy this file to .env.local and fill in your EmailJS credentials
# Vite only exposes variables prefixed with VITE_

# EmailJS service id
VITE_EMAILJS_SERVICE_ID=service_xxxxx

# EmailJS template id
VITE_EMAILJS_TEMPLATE_ID=template_xxxxx

# EmailJS public key
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Optional: default recipient (overrides code if set)
VITE_CONTACT_TO_EMAIL=divlynx.inc@gmail.com

# Optional: Calendly booking link
VITE_CALENDLY_URL=https://calendly.com/your-handle/intro-call

# Optional: default webmail provider for hero email CTA
# options: gmail | outlook | yahoo
VITE_DEFAULT_WEBMAIL=gmail
